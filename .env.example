JWT_SECRET=your_jwt_secret_here
ADMIN_SECRET=your_admin_secret_here

# Vercel Postgres — from your Vercel project's Storage tab (Postgres integration)
POSTGRES_URL=postgres://user:password@host/db

# Vercel Blob — from your Vercel project's Storage tab (Blob integration), used for KYC document uploads
BLOB_READ_WRITE_TOKEN=your_blob_token_here

# Optional: protects /api/cron/sltp from being hit by anyone but Vercel Cron
CRON_SECRET=your_cron_secret_here

# Optional: only needed if you connect a real MetaApi-managed MT5 account
METAAPI_TOKEN=
MT5_ACCOUNT_ID=

PORT=3000
NODE_ENV=production
